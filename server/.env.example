# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Database (MySQL / MariaDB) ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devdna
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ─── GitHub API ────────────────────────────────────────────
# Create a token at https://github.com/settings/tokens (public_repo/read scopes are enough)
GITHUB_TOKEN=

# ─── Google Gemini ─────────────────────────────────────────
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Cache ─────────────────────────────────────────────────
# How long (in minutes) a stored analysis is considered fresh
CACHE_TTL_MINUTES=360
